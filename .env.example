# ===================================================
# CUKURIN ENVIRONMENT VARIABLES (.env.example)
# ===================================================

# Database PostgreSQL (Neon.tech Serverless)
# DATABASE_URL: Pooled connection string (dipakai oleh Prisma Client runtime)
DATABASE_URL="postgresql://user:password@ep-xyz-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"

# DIRECT_URL: Direct unpooled connection string (dipakai khusus oleh Prisma Migrations)
DIRECT_URL="postgresql://user:password@ep-xyz.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# NextAuth / Auth.js
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="cukurin-super-secret-key-change-in-production-min-32-chars"

# App Info
NEXT_PUBLIC_APP_NAME="Cukurin"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
