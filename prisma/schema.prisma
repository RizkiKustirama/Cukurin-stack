// Prisma Schema for Cukurin Barbershop SaaS
// Engine: PostgreSQL (Neon.tech Serverless)
// Multi-Tenancy Isolation: Row-Level by tenant_id

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==========================================
// 1. GLOBAL ENUMS
// ==========================================

enum UserRole {
  SUPERADMIN
  PLATFORM_ADMIN
  OWNER
  MANAGER
  CASHIER
  BARBER

  @@map("user_role")
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  EXPIRED
  SUSPENDED

  @@map("subscription_status")
}

enum SubscriptionPlan {
  REGULER
  PRO
  ENTERPRISE

  @@map("subscription_plan")
}

enum QueueStrategy {
  LOYALTY_PRIORITY
  STRICT_FIFO

  @@map("queue_strategy")
}

enum BarberWorkStatus {
  READY
  BUSY
  BREAK
  OFFLINE

  @@map("barber_work_status")
}

enum EmploymentType {
  PERMANENT
  FREELANCE

  @@map("employment_type")
}

enum PayoutCycle {
  DAILY
  WEEKLY
  MONTHLY

  @@map("payout_cycle")
}

enum OrderType {
  SERVICE
  RETAIL_ONLY

  @@map("order_type")
}

enum ServiceStatus {
  WAITING
  IN_SERVICE
  COMPLETED
  CANCELLED

  @@map("service_status")
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID

  @@map("payment_status")
}

enum PaymentMethod {
  CASH
  QRIS
  TRANSFER
  EDC

  @@map("payment_method")
}

enum CommissionSource {
  SERVICE_FEE
  PRODUCT_BONUS
  TIP

  @@map("commission_source")
}

enum PayoutVia {
  CASH_DRAWER
  TRANSFER

  @@map("payout_via")
}

enum AssetCondition {
  GOOD
  MAINTENANCE
  DAMAGED
  LOST

  @@map("asset_condition")
}

// ==========================================
// 2. ENTITY MODELS (15 TABLES)
// ==========================================

/// Tabel 1: tenants (Akun Bisnis Barbershop)
model Tenant {
  id                 String             @id @default(uuid()) @db.Uuid
  name               String             @db.VarChar(100)
  slug               String             @unique @db.VarChar(100)
  brandName          String?            @map("brand_name") @db.VarChar(100)
  logoUrl            String?            @map("logo_url") @db.Text
  primaryColor       String             @default("#E0A96D") @map("primary_color") @db.VarChar(10)
  isOnboarded        Boolean            @default(false) @map("is_onboarded")
  subscriptionStatus SubscriptionStatus @default(TRIAL) @map("subscription_status")
  subscriptionPlan   SubscriptionPlan?  @map("subscription_plan")
  trialEndsAt        DateTime           @default(now()) @map("trial_ends_at")
  subscriptionEndsAt DateTime?          @map("subscription_ends_at")
  maxStores          Int                @default(1) @map("max_stores")
  maxBarbers         Int                @default(5) @map("max_barbers")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  stores    Store[]
  customers Customer[]
  users     User[]

  @@map("tenants")
}

/// Tabel 2: stores (Cabang Ruko Fisik)
model Store {
  id            String        @id @default(uuid()) @db.Uuid
  tenantId      String        @map("tenant_id") @db.Uuid
  name          String        @db.VarChar(100)
  address       String?       @db.Text
  phone         String?       @db.VarChar(20)
  queueStrategy QueueStrategy @default(LOYALTY_PRIORITY) @map("queue_strategy")
  vaultBalance  Decimal       @default(1000000.00) @map("vault_balance") @db.Decimal(12, 2)
  createdAt     DateTime      @default(now()) @map("created_at")

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users             User[]
  barberProfiles    BarberProfile[]
  services          Service[]
  products          Product[]
  storeConsumptions StoreConsumption[]
  storeAssets       StoreAsset[]
  dailyRegisters    DailyRegister[]
  tickets           Ticket[]

  @@map("stores")
}

/// Tabel 3: users (Akun Login Seluruh Level)
model User {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String?   @map("tenant_id") @db.Uuid
  storeId      String?   @map("store_id") @db.Uuid
  name         String    @db.VarChar(100)
  phone        String    @db.VarChar(20)
  email        String?   @db.VarChar(100)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  role         UserRole  @default(BARBER)
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")

  tenant          Tenant?         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store           Store?          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  barberProfile   BarberProfile?
  cashierTickets  Ticket[]        @relation("CashierTickets")
  cashierRegisters DailyRegister[] @relation("CashierRegisters")

  @@unique([tenantId, phone])
  @@map("users")
}

/// Tabel 4: barber_profiles (Detail Profil & Kompensasi Barber)
model BarberProfile {
  id                   String           @id @default(uuid()) @db.Uuid
  userId               String           @unique @map("user_id") @db.Uuid
  storeId              String           @map("store_id") @db.Uuid
  employmentType       EmploymentType   @default(PERMANENT) @map("employment_type")
  baseSalary           Decimal          @default(0.00) @map("base_salary") @db.Decimal(12, 2)
  serviceCommissionPct Decimal          @default(50.00) @map("service_commission_pct") @db.Decimal(5, 2)
  productCommissionFlat Decimal         @default(5000.00) @map("product_commission_flat") @db.Decimal(12, 2)
  payoutCycle          PayoutCycle      @default(DAILY) @map("payout_cycle")
  workStatus           BarberWorkStatus @default(OFFLINE) @map("work_status")
  lastReadyAt          DateTime?        @map("last_ready_at")

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  store             Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  commissionLedgers CommissionLedger[]
  assignedAssets    StoreAsset[]
  requestedTickets  Ticket[]           @relation("RequestedBarber")
  assignedTickets   Ticket[]           @relation("AssignedBarber")
  recommendedItems  TicketItem[]       @relation("RecommendedBarber")

  @@map("barber_profiles")
}

/// Tabel 5: services (Master Paket & Layanan Cukur)
model Service {
  id              String   @id @default(uuid()) @db.Uuid
  storeId         String   @map("store_id") @db.Uuid
  name            String   @db.VarChar(100)
  description     String?  @db.Text
  price           Decimal  @db.Decimal(12, 2)
  durationMinutes Int      @default(30) @map("duration_minutes")
  isActive        Boolean  @default(true) @map("is_active")

  store       Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  ticketItems TicketItem[]

  @@map("services")
}

/// Tabel 6: products (Master Produk Retail Toko)
model Product {
  id             String   @id @default(uuid()) @db.Uuid
  storeId        String   @map("store_id") @db.Uuid
  name           String   @db.VarChar(100)
  costPrice      Decimal  @default(0.00) @map("cost_price") @db.Decimal(12, 2)
  sellingPrice   Decimal  @map("selling_price") @db.Decimal(12, 2)
  stockQuantity  Int      @default(0) @map("stock_quantity")
  minStockAlert  Int      @default(3) @map("min_stock_alert")
  isActive       Boolean  @default(true) @map("is_active")

  store        Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  ticketItems  TicketItem[]
  consumptions StoreConsumption[]

  @@map("products")
}

/// Tabel 7: store_consumptions (Stok Gudang Dipakai ke Meja/Backbar)
model StoreConsumption {
  id            String   @id @default(uuid()) @db.Uuid
  storeId       String   @map("store_id") @db.Uuid
  productId     String   @map("product_id") @db.Uuid
  quantity      Int      @default(1)
  costValue     Decimal  @map("cost_value") @db.Decimal(12, 2)
  targetStation String   @map("target_station") @db.VarChar(50)
  notes         String?  @db.VarChar(255)
  createdAt     DateTime @default(now()) @map("created_at")

  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@map("store_consumptions")
}

/// Tabel 8: store_assets (Inventaris Alat & Mesin Cukur)
model StoreAsset {
  id              String          @id @default(uuid()) @db.Uuid
  storeId         String          @map("store_id") @db.Uuid
  name            String          @db.VarChar(100)
  serialNumber    String?         @map("serial_number") @db.VarChar(50)
  currentHolderId String?         @map("current_holder_id") @db.Uuid
  condition       AssetCondition  @default(GOOD)
  notes           String?         @db.Text
  createdAt       DateTime        @default(now()) @map("created_at")

  store         Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  currentHolder BarberProfile? @relation(fields: [currentHolderId], references: [id], onDelete: SetNull)

  @@map("store_assets")
}

/// Tabel 9: customers (CRM Pelanggan Tingkat Tenant/Brand)
model Customer {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  name        String   @db.VarChar(100)
  phone       String   @db.VarChar(20)
  haircutNotes String? @map("haircut_notes") @db.Text
  visitCount  Int      @default(1) @map("visit_count")
  lastVisitAt DateTime @default(now()) @map("last_visit_at")

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tickets Ticket[]

  @@index([tenantId, phone], name: "idx_customers_tenant_phone")
  @@map("customers")
}

/// Tabel 10: tickets (Tiket Transaksi & Antrean)
model Ticket {
  id                String        @id @default(uuid()) @db.Uuid
  ticketNumber      String        @map("ticket_number") @db.VarChar(30)
  storeId           String        @map("store_id") @db.Uuid
  customerId        String?       @map("customer_id") @db.Uuid
  orderType         OrderType     @default(SERVICE) @map("order_type")
  requestedBarberId String?       @map("requested_barber_id") @db.Uuid
  assignedBarberId  String?       @map("assigned_barber_id") @db.Uuid
  serviceStatus     ServiceStatus @default(WAITING) @map("service_status")
  paymentStatus     PaymentStatus @default(UNPAID) @map("payment_status")
  subtotal          Decimal       @default(0.00) @db.Decimal(12, 2)
  tipAmount         Decimal       @default(0.00) @map("tip_amount") @db.Decimal(12, 2)
  totalAmount       Decimal       @default(0.00) @map("total_amount") @db.Decimal(12, 2)
  cashierId         String        @map("cashier_id") @db.Uuid
  createdAt         DateTime      @default(now()) @map("created_at")
  closedAt          DateTime?     @map("closed_at")

  store             Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer          Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  requestedBarber   BarberProfile?     @relation("RequestedBarber", fields: [requestedBarberId], references: [id], onDelete: SetNull)
  assignedBarber    BarberProfile?     @relation("AssignedBarber", fields: [assignedBarberId], references: [id], onDelete: SetNull)
  cashier           User               @relation("CashierTickets", fields: [cashierId], references: [id], onDelete: Restrict)
  items             TicketItem[]
  payments          TicketPayment[]
  commissionLedgers CommissionLedger[]

  @@index([storeId, serviceStatus, createdAt], name: "idx_tickets_queue")
  @@map("tickets")
}

/// Tabel 11: ticket_items (Rincian Item dalam Tiket)
model TicketItem {
  id               String   @id @default(uuid()) @db.Uuid
  ticketId         String   @map("ticket_id") @db.Uuid
  itemType         String   @map("item_type") @db.VarChar(20) // 'SERVICE' atau 'PRODUCT'
  serviceId        String?  @map("service_id") @db.Uuid
  productId        String?  @map("product_id") @db.Uuid
  itemName         String   @map("item_name") @db.VarChar(100)
  price            Decimal  @db.Decimal(12, 2)
  quantity         Int      @default(1)
  subtotal         Decimal  @db.Decimal(12, 2)
  recommendedById  String?  @map("recommended_by_id") @db.Uuid
  commissionAmount Decimal  @default(0.00) @map("commission_amount") @db.Decimal(12, 2)

  ticket        Ticket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  service       Service?       @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  product       Product?       @relation(fields: [productId], references: [id], onDelete: SetNull)
  recommendedBy BarberProfile? @relation("RecommendedBarber", fields: [recommendedById], references: [id], onDelete: SetNull)

  @@map("ticket_items")
}

/// Tabel 12: ticket_payments (Pencatatan Pembayaran)
model TicketPayment {
  id              String        @id @default(uuid()) @db.Uuid
  ticketId        String        @map("ticket_id") @db.Uuid
  dailyRegisterId String        @map("daily_register_id") @db.Uuid
  paymentMethod   PaymentMethod @default(CASH) @map("payment_method")
  amount          Decimal       @db.Decimal(12, 2)
  createdAt       DateTime      @default(now()) @map("created_at")

  ticket        Ticket        @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  dailyRegister DailyRegister @relation(fields: [dailyRegisterId], references: [id], onDelete: Restrict)

  @@index([dailyRegisterId], name: "idx_tickets_daily_register")
  @@map("ticket_payments")
}

/// Tabel 13: daily_registers (Buku Kas Harian Toko)
model DailyRegister {
  id              String    @id @default(uuid()) @db.Uuid
  storeId         String    @map("store_id") @db.Uuid
  cashierId       String    @map("cashier_id") @db.Uuid
  openedAt        DateTime  @default(now()) @map("opened_at")
  closedAt        DateTime? @map("closed_at")
  openingCash     Decimal   @default(0.00) @map("opening_cash") @db.Decimal(12, 2)
  expectedCash    Decimal?  @map("expected_cash") @db.Decimal(12, 2)
  actualCash      Decimal?  @map("actual_cash") @db.Decimal(12, 2)
  discrepancyCash Decimal?  @map("discrepancy_cash") @db.Decimal(12, 2)
  status          String    @default("OPEN") @db.VarChar(20) // 'OPEN' atau 'CLOSED'
  notes           String?   @db.Text

  store              Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  cashier            User                @relation("CashierRegisters", fields: [cashierId], references: [id], onDelete: Restrict)
  payments           TicketPayment[]
  pettyCashExpenses  PettyCashExpense[]
  commissionLedgers  CommissionLedger[]

  @@map("daily_registers")
}

/// Tabel 14: petty_cash_expenses (Pengeluaran Kas Kecil Laci)
model PettyCashExpense {
  id              String   @id @default(uuid()) @db.Uuid
  dailyRegisterId String   @map("daily_register_id") @db.Uuid
  amount          Decimal  @db.Decimal(12, 2)
  category        String   @default("OPERASIONAL") @db.VarChar(50)
  notes           String   @db.VarChar(255)
  createdAt       DateTime @default(now()) @map("created_at")

  dailyRegister DailyRegister @relation(fields: [dailyRegisterId], references: [id], onDelete: Cascade)

  @@map("petty_cash_expenses")
}

/// Tabel 15: commission_ledgers (Buku Besar Saldo Komisi Barber)
model CommissionLedger {
  id              String           @id @default(uuid()) @db.Uuid
  barberId        String           @map("barber_id") @db.Uuid
  ticketId        String?          @map("ticket_id") @db.Uuid
  dailyRegisterId String?          @map("daily_register_id") @db.Uuid
  sourceType      CommissionSource @map("source_type")
  amount          Decimal          @db.Decimal(12, 2)
  isPaidOut       Boolean          @default(false) @map("is_paid_out")
  paidVia         PayoutVia?       @map("paid_via")
  paidOutAt       DateTime?        @map("paid_out_at")

  barber        BarberProfile  @relation(fields: [barberId], references: [id], onDelete: Cascade)
  ticket        Ticket?        @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  dailyRegister DailyRegister? @relation(fields: [dailyRegisterId], references: [id], onDelete: SetNull)

  @@index([barberId, isPaidOut], name: "idx_commissions_barber_unpaid")
  @@map("commission_ledgers")
}
